# Root .gitignore for Sekolah (Flutter + Laravel)

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & Secrets (NEVER COMMIT)
*.env
*.env.*
!.env.example
*.keystore
*.jks
*.p12
*.pem

# Composer / Laravel Backend
backend/vendor/
backend/node_modules/
backend/public/storage
backend/public/hot
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitignore
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/.phpunit.result.cache

# Flutter Mobile
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/ios/Podfile.lock
mobile/ios/.symlinks/
mobile/*.iml
mobile/android/*.iml
